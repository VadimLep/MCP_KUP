Функция ОписаниеВидовЗаявляемыхВЧате(ВидДоговораСтрахования)
    Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПравилаОформленияЗаявленийУбытка.ВидДоговораСтрахования КАК ВидДоговораСтрахования,
	|	ПравилаОформленияЗаявленийУбытка.ОписаниеПравилаОформления КАК ОписаниеПравилаОформления,
	|	ПравилаОформленияЗаявленийУбытка.РазрешеноЗаявлениеОнлайн КАК РазрешеноЗаявлениеОнлайн
	|ИЗ
	|	РегистрСведений.ПравилаОформленияЗаявленийУбытка КАК ПравилаОформленияЗаявленийУбытка
	|ГДЕ
	|	ПравилаОформленияЗаявленийУбытка.ВидДоговораСтрахования = &ВидДоговораСтрахования
	|	ИЛИ ПравилаОформленияЗаявленийУбытка.ВидДоговораСтрахования.ВидДоговора = &ВидДоговораСтрахования";
	Запрос.УстановитьПараметр("ВидДоговораСтрахования", ВидДоговораСтрахования);
	ДанныеВозврата = Новый Структура("ВидДоговораСтрахования,ОписаниеПравилаОформления,РазрешеноЗаявлениеОнлайн", ВидДоговораСтрахования, "Можно оформить онлайн в личном кабинете либо в этом чате.", Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда
		ЗаполнитьЗначенияСвойств(ДанныеВозврата, Выборка);
	КонецЕсли;	
	
	Возврат ДанныеВозврата;
КонецФункции

Функция ПолучитьВидСтрахования(НомерПравил)
