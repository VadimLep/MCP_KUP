#Область ВызовИнструментов

Функция ВызовИнструментаMCP(Сообщение, Идентификатор)

	// По спецификации JSON-RPC поле params может отсутствовать или быть равно null
	// (например, {"method":"tools/call","params":null}) - это не ошибка протокола.
	ПараметрыВызова = Неопределено;
	Если Сообщение.Свойство("params", ПараметрыВызова) Тогда
		Если ПараметрыВызова = Null Или ПараметрыВызова = Неопределено Тогда
			ПараметрыВызова = Новый Структура;
		КонецЕсли;
	Иначе
		ПараметрыВызова = Новый Структура;
	КонецЕсли;
	Если ТипЗнч(ПараметрыВызова) <> Тип("Структура") Тогда
		Возврат КонструкторОшибкиMCP(-32602, "Некорректный тип params метода tools/call", Идентификатор);
	КонецЕсли;

	ИмяИнструмента = "";
	Если Не ПараметрыВызова.Свойство("name", ИмяИнструмента) Или ПустаяСтрока(ИмяИнструмента) Тогда
		Возврат КонструкторОшибкиMCP(-32602, "Отсутствует имя инструмента (params.name)", Идентификатор);
	КонецЕсли;

	// Аргументы инструмента по протоколу MCP передаются во вложенном объекте
	// params.arguments (а не в params напрямую).
	Аргументы = Неопределено;
	Если ПараметрыВызова.Свойство("arguments", Аргументы) И ТипЗнч(Аргументы) = Тип("Структура") Тогда
		// Стандартный вызов MCP: {"params": {"name": ..., "arguments": {...}}}
	ИначеЕсли Сообщение.Свойство("arguments") И ТипЗнч(Сообщение.arguments) = Тип("Структура") Тогда
		// Обратная совместимость: аргументы переданы прямо в корне сообщения.
		Аргументы = Сообщение.arguments;
	Иначе
		// Обратная совместимость с прежним расширением: аргументы в params,
		// кроме служебного поля name.
		Аргументы = Новый Структура;
		Для Каждого КлючИзЗначение Из ПараметрыВызова Цикл
			Если КлючИзЗначение.Ключ <> "name" Тогда
				Аргументы.Вставить(КлючИзЗначение.Ключ, КлючИзЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если ИмяИнструмента = "create_case" Тогда
		Возврат ИнструментСоздатьЗаявление(Аргументы, Идентификатор);
	ИначеЕсли ИмяИнструмента = "get_case" Тогда
		Возврат ИнструментПолучитьЗаявление(Аргументы, Идентификатор);
	ИначеЕсли ИмяИнструмента = "get_police" Тогда
		Возврат ИнструментПолучитьПолис(Аргументы, Идентификатор);
	ИначеЕсли ИмяИнструмента = "list_cases" Тогда
		Возврат ИнструментСписокЗаявлений(Аргументы, Идентификатор);
	ИначеЕсли ИмяИнструмента = "list_polises" Тогда
		Возврат ИнструментСписокПолисов(Аргументы, Идентификатор);
	ИначеЕсли ИмяИнструмента = "get_client_name" Тогда
		Возврат ИнструментИмяКлиента(Аргументы, Идентификатор);
	ИначеЕсли ИмяИнструмента = "get_rules_case" Тогда
		Возврат ИнструментПолучениеПравилОформленияЗаявления(Аргументы, Идентификатор);
	ИначеЕсли ИмяИнструмента = "list_managers" Тогда
		Возврат ИнструментСписокОператоров(Аргументы, Идентификатор);
	ИначеЕсли ИмяИнструмента = "put_to_manager" Тогда
		Возврат ИнструментПереключениеНаОператора(Аргументы, Идентификатор);
	Иначе
		Возврат КонструкторОшибкиMCP(-32602, "Инструмент не найден: " + ИмяИнструмента, Идентификатор);
	КонецЕсли;

КонецФункции

Функция ТекстИнструментаMCP(Знач ТекстОтвета, Знач ПризнакОшибки, Знач ДанныеИнструмента = Неопределено)

	Содержимое = Новый Массив;
	Содержимое.Добавить(Новый Структура("type, text", "text", ТекстОтвета));
	Если ДанныеИнструмента <> Неопределено Тогда
		Возврат Новый Структура("content, isError, structuredContent", Содержимое, ПризнакОшибки, ДанныеИнструмента);
	КонецЕсли;
	Возврат Новый Структура("content, isError", Содержимое, ПризнакОшибки);

КонецФункции

Функция ПолучитьДокументВводимыйНаОсновании(МетаданныеЖурналаДокументов, МетаданныеДокументаНеИзЖурнала)
    
    Для Каждого МетаданныеДокумента Из МетаданныеЖурналаДокументов.РегистрируемыеДокументы Цикл
        
        Для Каждого Основание Из МетаданныеДокумента.ВводитсяНаОсновании Цикл
            Если Основание = МетаданныеДокументаНеИзЖурнала Тогда
                Возврат МетаданныеДокумента;
            КонецЕсли;
        КонецЦикла;
        
    КонецЦикла;
    
    Возврат Неопределено;
    
КонецФункции

