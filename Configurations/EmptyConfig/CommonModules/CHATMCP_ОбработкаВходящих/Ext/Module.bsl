Функция ИнструментСоздатьЗаявление(Аргументы, Идентификатор)

	// --- Обязательные реквизиты -------------------------------------------------
	НомерПолиса = ЗначениеАргумента(Аргументы, "police_number");
	КлиентUUID = ЗначениеАргумента(Аргументы, "client_uuid");     
	case_description = ЗначениеАргумента(Аргументы, "case_description");
	Если ПустаяСтрока(НомерПолиса) Тогда
		Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
			"Не задан обязательный параметр police_number (Номер полиса).", Истина), Идентификатор);
	КонецЕсли;
	Если ПустаяСтрока(КлиентUUID) Тогда
		Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
			"Не задан обязательный параметр client_uuid.", Истина), Идентификатор);
	КонецЕсли;

	//Попытка
	//	ИдентификаторОбъекта = Новый УникальныйИдентификатор(police_uuid);
	//Исключение
	//	Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
	//		"Некорректный police_uuid: " + police_uuid, Истина), Идентификатор);
	//КонецПопытки;  
	
 	Попытка
		КлиентСсылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(КлиентUUID));
	Исключение
		Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
			"Некорректный client_uuid: " + КлиентUUID, Истина), Идентификатор);
	КонецПопытки;  

	// --- Создание документа -------------------------------------------------------  
	
	Выборка = ПолучитьСтруктуруПолиса(НомерПолиса, КлиентUUID);    
	
	
	Если Выборка = Неопределено Тогда
		Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
			"Страховой полис с номером """ + НомерПолиса + """ не найден.", Истина), Идентификатор);
	КонецЕсли;
	ДоговорСсылка = Выборка.Ссылка;     
	
	//текстСообщения = "";
	СтруктураОписания = ОписаниеВидовЗаявляемыхВЧате(ДоговорСсылка._Вид);
	Если СтруктураОписания.РазрешеноЗаявлениеОнлайн=Ложь тогда
		ДанныеИнструмента = Новый Структура();
		ДанныеИнструмента.Вставить("outcome", "unsupported_product_type");
		ДанныеИнструмента.Вставить("retryable", Ложь);
		ДанныеИнструмента.Вставить("case_created", Ложь);
		ДанныеИнструмента.Вставить("police_number", НомерПолиса);
		ДанныеИнструмента.Вставить("product_type", ""+ДоговорСсылка._Вид);
		//ДанныеИнструмента.Вставить("alternative_channels", ПолучитьАльтернативныеКаналы());
		ДанныеИнструмента.Вставить("user_message", СтруктураОписания.ОписаниеПравилаОформления);
		ДанныеИнструмента.Вставить("next_action", "inform_user");
		Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
			СтруктураОписания.ОписаниеПравилаОформления, Ложь, ДанныеИнструмента), Идентификатор);
	КонецЕсли;	
	
	МетаданныеЗаявления = ПолучитьДокументВводимыйНаОсновании(Метаданные.ЖурналыДокументов.ЖурналЗаявлений, ДоговорСсылка.Метаданные());
	Если МетаданныеЗаявления=Неопределено тогда
		Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
			"Не верно задан параметр police_number (Номер полиса), в результате не найден договор страхования, на основании которого должно вноситься заявление убытка.", Истина), Идентификатор);
	КонецЕсли;	
	
	
	Объект = Документы[МетаданныеЗаявления.Имя].СоздатьДокумент(); 
	Объект.Заполнить(ДоговорСсылка);
	Объект.Дата = ТекущаяДата();
	Объект.Заявитель = КлиентСсылка;
    Объект.Примечание = case_description;



	// --- Запись ---------------------------------------------------------------------
	Попытка
		Объект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
			"Ошибка записи документа: " + ОписаниеОшибки(), Истина), Идентификатор);
	КонецПопытки;

	Выборка = ПолучитьСтруктуруЗаявленияПоСсылке(Объект.Ссылка);
	

	Текст = "Номер: " + Выборка.Номер + Символы.ПС
		+ "Дата: " + Формат(Выборка.Дата, "ДФ=yyyy-MM-dd HH:mm") + Символы.ПС
		+ "Статус: " + Выборка.Статус + Символы.ПС
		+ "Заявитель: " + Выборка.Заявитель + Символы.ПС
		+ "Номер договора: " + Выборка.НомерДоговора + Символы.ПС
		+ "Статус: " + Выборка.Статус + Символы.ПС
		+ "Вид страхования: " + Выборка.ВидДоговора + Символы.ПС
		+ "Вид страхового случая: " + Выборка.ВидСтраховогоСлучая;
	Данные = Новый Структура("uuid, number, date, status, applicant, police_number, type_insurance, type_event",
		Строка(Выборка.Ссылка.УникальныйИдентификатор()),
		Выборка.Номер,
		Формат(Выборка.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"),
		Строка(Выборка.Статус),
		""+Выборка.Заявитель,
		Выборка.НомерДоговора,
		""+Выборка.ВидДоговора,
		""+Выборка.ВидСтраховогоСлучая);

	Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(Текст, Ложь, Данные), Идентификатор);

КонецФункции

Функция ИнструментПолучитьЗаявление(Аргументы, Идентификатор)

	//СтрокаUUID = ЗначениеАргумента(Аргументы, "case_uuid");
	НомерЗаявления = ЗначениеАргумента(Аргументы, "case_number");
	КлиентUUID = ЗначениеАргумента(Аргументы, "client_uuid");
	Если ПустаяСтрока(КлиентUUID) Тогда
		Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
			"Не задан обязательный параметр client_uuid.", Истина), Идентификатор);
	КонецЕсли;
	Если ПустаяСтрока(НомерЗаявления)Тогда
		Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
			"Не задан обязательный параметр case_number (номер заявления).", Истина), Идентификатор);
	КонецЕсли;


	Выборка = ПолучитьСтруктуруЗаявления(НомерЗаявления, КлиентUUID);
	Если не ЗначениеЗаполнено(Выборка) Тогда
		Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
			"Заявление с номером """ + НомерЗаявления + """ не найдено.", Истина), Идентификатор);
	КонецЕсли;

	Текст = "Номер: " + Выборка.Номер + Символы.ПС
		+ "Дата: " + Формат(Выборка.Дата, "ДФ=yyyy-MM-dd HH:mm") + Символы.ПС
		+ "Статус: " + Выборка.Статус + Символы.ПС
		+ "Заявитель: " + Выборка.Заявитель + Символы.ПС
		+ "Номер договора: " + Выборка.НомерДоговора + Символы.ПС
		+ "Статус: " + Выборка.Статус + Символы.ПС
		+ "Вид страхования: " + Выборка.ВидДоговора + Символы.ПС
		+ "Вид страхового случая: " + Выборка.ВидСтраховогоСлучая;
	Данные = Новый Структура("case_uuid, case_number, date, status, applicant, police_number, type_insurance, type_event",
		Строка(Выборка.Ссылка.УникальныйИдентификатор()),
		Выборка.Номер,
		Формат(Выборка.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"),
		Строка(Выборка.Статус),
		""+Выборка.Заявитель,
		Выборка.НомерДоговора,
		""+Выборка.ВидДоговора,
		""+Выборка.ВидСтраховогоСлучая);

	Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(Текст, Ложь, Данные), Идентификатор);

КонецФункции


Функция ИнструментПолучитьПолис(Аргументы, Идентификатор)

	НомерПолиса = ЗначениеАргумента(Аргументы, "police_number");
	КлиентUUID = ЗначениеАргумента(Аргументы, "client_uuid");
	Если не ЗначениеЗаполнено(НомерПолиса) Тогда
		Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
			"Должен быть обязательно задан police_number (Номер полиса).", Истина), Идентификатор);
	КонецЕсли;

	
	Если не ЗначениеЗаполнено(КлиентUUID) и не ЗначениеЗаполнено(НомерПолиса) Тогда
		Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
			"Для поиска полисов нужно обязательно указать либо номер полиса (параматр police_number) либо uuid страхователя (параметр client_uuid)",
			Истина), Идентификатор);
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(КлиентUUID) тогда
		СтраховательСсылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(КлиентUUID));
	КонецЕсли;  
	
	Если не ЗначениеЗаполнено(СтраховательСсылка) Тогда
		Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
			"неверно указан или не указан uuid страхователя (параметр client_uuid)",
			Истина), Идентификатор);
	КонецЕсли; 
	
	
	СтруктураПолиса = ПолучитьСтруктуруПолиса(НомерПолиса, КлиентUUID);
	ДоговорСсылка = СтруктураПолиса.Ссылка;
	
	МассивПолисов = ПолучитьСписокПолисов(СтраховательСсылка, 1, ДоговорСсылка);
	Если не ЗначениеЗаполнено(МассивПолисов) Тогда
		Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
			"Страховой полис с номером """ + НомерПолиса + """ не найден.", Истина), Идентификатор);
	КонецЕсли;
	Выборка=МассивПолисов[0];
	
	Текст = 
	"" + Выборка.Номер + " от " + Формат(Выборка.Дата, "ДФ=yyyy-MM-dd") + " | " + Формат(Выборка.ДатаВступленияВСилу, "ДФ=yyyy-MM-dd") 
	+ " | " + Формат(Выборка.ДатаПрекращенияДействия, "ДФ=yyyy-MM-dd")
	+ " | " + Выборка.Страхователь + " | " + Выборка.ВидДоговора + " | " + Выборка.ПравилаСтрахования 
	+ " | " + Выборка.СтраховаяСумма + " | " + Выборка.СтраховаяПремия  + " | " + Выборка.Валюта
	+ " | " + Выборка.Задолженность + " | " + Выборка.ОбъектСтрахования 
	+ " | " + Выборка.МестоДействия + " | " + Выборка.Примечание + " | " + Выборка.РазрешеноЗаявлениеОнлайн + " | " + Выборка.ОписаниеПравилаОформления;
	
	Данные = Новый Структура("uuid, number, date, begin_date, 
	|end_date, 
	|insurer, type_insurance, RuleDescription, 
	|insure_sum, insure_premium, currency, 
	|ToPay, Insured, 
	|Scope, Description, Allowed_to_submit_case_online, Rules_for_submit_case",
	Строка(Выборка.УникальныйИдентификатор),
	Выборка.Номер,
	Формат(Выборка.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"),
	Формат(Выборка.ДатаВступленияВСилу, "ДФ=yyyy-MM-dd"),
	Формат(Выборка.ДатаПрекращенияДействия, "ДФ=yyyy-MM-dd"),
	Строка(Выборка.Страхователь),
	""+Выборка.ВидДоговора,
	""+Выборка.ПравилаСтрахования,
	Выборка.СтраховаяСумма,
	Выборка.СтраховаяПремия,
	""+Выборка.Валюта,
	Выборка.Задолженность,
	""+Выборка.ОбъектСтрахования,
	""+Выборка.МестоДействия,
	""+Выборка.Примечание,
	Выборка.РазрешеноЗаявлениеОнлайн, 
	Выборка.ОписаниеПравилаОформления);
			

	Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(Текст, Ложь, Данные), Идентификатор);

КонецФункции

Функция ИнструментПолучениеПравилОформленияЗаявления(Аргументы, Идентификатор)
	НомерПолиса = ЗначениеАргумента(Аргументы, "police_number");
	КлиентUUID = ЗначениеАргумента(Аргументы, "client_uuid");
	Если не ЗначениеЗаполнено(НомерПолиса) Тогда
		Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
			"Должен быть обязательно задан police_number (Номер полиса).", Истина), Идентификатор);
	КонецЕсли;

	Если ЗначениеЗаполнено(КлиентUUID) тогда
		СтраховательСсылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(КлиентUUID));
	КонецЕсли;  
	
	Если не ЗначениеЗаполнено(СтраховательСсылка) Тогда
		Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
			"неверно указан или не указан uuid страхователя (параметр client_uuid)",
			Истина), Идентификатор);
	КонецЕсли; 
	
	
	СтруктураПолиса = ПолучитьСтруктуруПолиса(НомерПолиса, КлиентUUID);
	ДоговорСсылка = СтруктураПолиса.Ссылка;
	
	СтруктураОписания = ОписаниеВидовЗаявляемыхВЧате(ДоговорСсылка._Вид);
	
	Текст = 
	"" + ДоговорСсылка.Номер + " от " + Формат(ДоговорСсылка.Дата, "ДФ=yyyy-MM-dd") + СтруктураОписания.РазрешеноЗаявлениеОнлайн + " | " + СтруктураОписания.ОписаниеПравилаОформления;
	
	Данные = Новый Структура("uuid, number, date, Allowed_to_submit_case_online, Rules_for_submit_case",
	Строка(ДоговорСсылка.УникальныйИдентификатор()),
	ДоговорСсылка.Номер,
	Формат(ДоговорСсылка.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"),
	СтруктураОписания.РазрешеноЗаявлениеОнлайн, 
	СтруктураОписания.ОписаниеПравилаОформления);
			

	Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(Текст, Ложь, Данные), Идентификатор);

КонецФункции


Функция ИнструментСписокЗаявлений(Аргументы, Идентификатор)

	МаксимумСтрок = 20;
	СтрокаЛимит = ЗначениеАргумента(Аргументы, "limit");
	Если Не ПустаяСтрока(СтрокаЛимит) Тогда
		Попытка
			МаксимумСтрок = Мин(Число(СтрокаЛимит), 100);
			Если МаксимумСтрок < 1 Тогда
				МаксимумСтрок = 20;
			КонецЕсли;
		Исключение
			МаксимумСтрок = 20;
		КонецПопытки;
	КонецЕсли;

	Условия = "";

	КлиентUUID = ЗначениеАргумента(Аргументы, "client_uuid");   
	Если ПустаяСтрока(КлиентUUID) Тогда
		Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
		"Не задан обязательный параметр client_uuid.", Истина), Идентификатор);
	КонецЕсли;
 	Попытка
		КлиентСсылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(КлиентUUID));
	Исключение
		Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
			"Некорректный client_uuid: " + КлиентUUID, Истина), Идентификатор);
	КонецПопытки;  

	Статус = ЗначениеАргумента(Аргументы, "status");
	ЗначениеСтатуса = Неопределено;
	Если Не ПустаяСтрока(Статус) и не Статус="Оформлен" Тогда
		ЗначениеСтатуса = Перечисления.СтатусыУбытков.НайтиПоИмени(Статус);
		Если не ЗначениеЗаполнено(ЗначениеСтатуса) Тогда
			Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
				"Неизвестный статус: """ + Статус
				+ """. Допустимые: Оформлен, Заявлен, Урегулирован, ОтказаноВВыплате.",
				Истина), Идентификатор);
			КонецЕсли;  
	ИначеЕсли Статус="Оформлен" тогда 
		ЗначениеСтатуса = "Оформлен";
	Иначе
		//Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
		//	"Неизвестный статус: """ + Статус
		//	+ """. Допустимые: Оформлен, Заявлен, Урегулирован, ОтказаноВВыплате.",
		//	Истина), Идентификатор);
	КонецЕсли;


	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 20
	|	ЖурналЗаявлений.Ссылка КАК Ссылка,
	|	ЖурналЗаявлений.Дата КАК Дата,
	|	ЖурналЗаявлений.Номер КАК Номер,
	|	ЖурналДоговоров.Номер КАК НомерДоговора,
	|	СостоянияЗаявленийСрезПоследних.Статус КАК Статус,
	|	ЖурналЗаявлений.Заявитель КАК Заявитель,
	|	ЖурналЗаявлений.ВидСтраховогоСлучая КАК ВидСтраховогоСлучая,
	|	ВидыСтрахования.Ссылка КАК ВидСтрахования
	|ПОМЕСТИТЬ Выборка
	|ИЗ
	|	ЖурналДокументов.ЖурналЗаявлений КАК ЖурналЗаявлений
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЖурналДокументов.ЖурналДоговоров КАК ЖурналДоговоров
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыСтрахования КАК ВидыСтрахования
	|			ПО (ВидыСтрахования.ВидДоговора = ЖурналДоговоров.ВидДоговора)
	|		ПО ЖурналЗаявлений.Договор = ЖурналДоговоров.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаявлений.СрезПоследних КАК СостоянияЗаявленийСрезПоследних
	|		ПО ЖурналЗаявлений.Ссылка = СостоянияЗаявленийСрезПоследних.Заявление
	|ГДЕ
	|	(СостоянияЗаявленийСрезПоследних.Статус = &Статус
	|			ИЛИ &ЛюбойСтатус)
	|	И ЖурналЗаявлений.Заявитель = &Заявитель
	|	И ЖурналЗаявлений.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 20
	|	ЖурналЗаявлений.Ссылка,
	|	ЖурналЗаявлений.Дата,
	|	ЖурналЗаявлений.Номер,
	|	ЖурналДоговоров.Номер,
	|	""Оформлен"",
	|	ЖурналЗаявлений.Заявитель,
	|	ЖурналЗаявлений.ВидСтраховогоСлучая,
	|	ВидыСтрахования.Ссылка
	|ИЗ
	|	ЖурналДокументов.ЖурналЗаявлений КАК ЖурналЗаявлений
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЖурналДокументов.ЖурналДоговоров КАК ЖурналДоговоров
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыСтрахования КАК ВидыСтрахования
	|			ПО (ВидыСтрахования.ВидДоговора = ЖурналДоговоров.ВидДоговора)
	|		ПО ЖурналЗаявлений.Договор = ЖурналДоговоров.Ссылка
	|ГДЕ
	|	(&Статус = ""Оформлен""
	|			ИЛИ &ЛюбойСтатус)
	|	И НЕ ЖурналЗаявлений.ПометкаУдаления
	|	И НЕ ЖурналЗаявлений.Проведен
	|	И ЖурналЗаявлений.Заявитель = &Заявитель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 20
	|	Выборка.Ссылка КАК Ссылка,
	|	Выборка.Дата КАК Дата,
	|	Выборка.Номер КАК Номер,
	|	Выборка.НомерДоговора КАК НомерДоговора,
	|	Выборка.Статус КАК Статус,
	|	Выборка.Заявитель КАК Заявитель,
	|	Выборка.ВидСтраховогоСлучая КАК ВидСтраховогоСлучая,
	|	Выборка.ВидСтрахования КАК ВидСтрахования
	|ИЗ
	|	Выборка КАК Выборка";
	
	Запрос.УстановитьПараметр("Заявитель", КлиентСсылка);
	Запрос.УстановитьПараметр("Статус", ЗначениеСтатуса);
	Запрос.УстановитьПараметр("ЛюбойСтатус", ПустаяСтрока(Статус));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "20", Формат(МаксимумСтрок, "ЧГ=0"));

	Выборка = Запрос.Выполнить().Выбрать();

	НомерСтроки = 0;
	Текст = "";
	МассивЗаявлений = Новый Массив;
	Пока Выборка.Следующий() Цикл
		НомерСтроки = НомерСтроки + 1;
		Текст = "Номер: " + Выборка.Номер + Символы.ПС
			+ "Дата: " + Формат(Выборка.Дата, "ДФ=yyyy-MM-dd HH:mm") + Символы.ПС
			+ "Статус: " + Выборка.Статус + Символы.ПС
			+ "Заявитель: " + Выборка.Заявитель + Символы.ПС
			+ "Номер договора: " + Выборка.НомерДоговора + Символы.ПС
			+ "Статус: " + Выборка.Статус + Символы.ПС
			+ "Вид страхования: " + Выборка.ВидСтрахования + Символы.ПС
			+ "Вид страхового случая: " + Выборка.ВидСтраховогоСлучая;
		МассивЗаявлений.Добавить(Новый Структура("uuid, number, date, status, applicant, police_number, type_insurance, type_event",
			Строка(Выборка.Ссылка.УникальныйИдентификатор()),
			Выборка.Номер,
			Формат(Выборка.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"),
			Строка(Выборка.Статус),
			""+Выборка.Заявитель,
			Выборка.НомерДоговора,
			""+Выборка.ВидСтрахования,
			""+Выборка.ВидСтраховогоСлучая));
	КонецЦикла;

	Если НомерСтроки = 0 Тогда
		Текст = "Заказы не найдены.";
	КонецЕсли;

	Возврат КонструкторРезультатаMCP(
		ТекстИнструментаMCP(Текст, Ложь, Новый Структура("orders", МассивЗаявлений)), Идентификатор);

КонецФункции

Функция ПолучитьСписокПолисов(Контрагент, Limit, ДоговорСсылка=Неопределено)
	PoliceList = InsuranceOnline.GetPoliceList(Неопределено, Неопределено, Неопределено, Неопределено, 1, Limit, 999999, Неопределено, ДоговорСсылка, Неопределено, Контрагент, Истина);	
	МассивВозврата = Новый Массив;
	Для каждого PoliceListItem из PoliceList.Item цикл
	    СтруктураВозврата = Новый Структура("УникальныйИдентификатор,Ссылка,Номер,Дата,ВидДоговора,ДатаВступленияВСилу,ДатаПрекращенияДействия,Страхователь,СтраховаяСумма,СтраховаяПремия,Валюта,Задолженность,ОбъектСтрахования,Примечание,ПравилаСтрахования,МестоДействия,РазрешеноЗаявлениеОнлайн,ОписаниеПравилаОформления");
		СтруктураВозврата.УникальныйИдентификатор = PoliceListItem.PoliceGUID;	
		СтруктураВозврата.Номер = PoliceListItem.PoliceNumber;	
		СтруктураВозврата.Дата = PoliceListItem.PoliceDate;	
		СтруктураВозврата.ДатаВступленияВСилу = PoliceListItem.BeginDate;	
		СтруктураВозврата.ДатаПрекращенияДействия = PoliceListItem.EndDate;	
		СтруктураВозврата.Страхователь = PoliceListItem.Insurer;	
		СтруктураВозврата.СтраховаяПремия = PoliceListItem.Sum;	
		СтруктураВозврата.СтраховаяСумма = PoliceListItem.Premium;	
		СтруктураВозврата.Задолженность = PoliceListItem.ToPay;	
		СтруктураВозврата.ОбъектСтрахования = PoliceListItem.Insured;	
		СтруктураВозврата.Валюта = PoliceListItem.Currency.CURRENCY_NAME;	
		СтруктураВозврата.Примечание = PoliceListItem.Description;	
		СтруктураВозврата.ВидДоговора = PoliceListItem.RuleName;	
		СтруктураВозврата.ПравилаСтрахования = PoliceListItem.RuleDescription;	
		СтруктураВозврата.МестоДействия = PoliceListItem.Scope;	  
		СтруктураОписания = ОписаниеВидовЗаявляемыхВЧате(ПолучитьВидСтрахования(PoliceListItem.Rule));
		СтруктураВозврата.РазрешеноЗаявлениеОнлайн = СтруктураОписания.РазрешеноЗаявлениеОнлайн;	
		СтруктураВозврата.ОписаниеПравилаОформления = СтруктураОписания.ОписаниеПравилаОформления;	
		МассивВозврата.Добавить(СтруктураВозврата);
	КонецЦикла;
	Возврат МассивВозврата;
КонецФункции	

Функция ИнструментСписокПолисов(Аргументы, Идентификатор)

	МаксимумСтрок = 20;
	СтрокаЛимит = ЗначениеАргумента(Аргументы, "limit");
	Номер = ЗначениеАргумента(Аргументы, "police_number");
	Если Не ПустаяСтрока(СтрокаЛимит) Тогда
		Попытка
			МаксимумСтрок = Мин(Число(СтрокаЛимит), 100);
			Если МаксимумСтрок < 1 Тогда
				МаксимумСтрок = 20;
			КонецЕсли;
		Исключение
			МаксимумСтрок = 20;
		КонецПопытки;
	КонецЕсли;


	Страхователь = ЗначениеАргумента(Аргументы, "client_uuid");      
	
	Если не ЗначениеЗаполнено(Страхователь) и не ЗначениеЗаполнено(Номер) Тогда
		Возврат КонструкторРезультатаMCP(ТекстИнструментаMCP(
			"Для поиска полисов нужно обязательно указать либо номер полиса (параматр police_number) либо uuid страхователя (параметр client_uuid)",
			Истина), Идентификатор);
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Страхователь) тогда
