			Строка(Выборка.УникальныйИдентификатор),
			Выборка.Номер,
			Формат(Выборка.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"),
			Формат(Выборка.ДатаВступленияВСилу, "ДФ=yyyy-MM-dd"),
			Формат(Выборка.ДатаПрекращенияДействия, "ДФ=yyyy-MM-dd"),
			Строка(Выборка.Страхователь),
			""+Выборка.ВидДоговора,
			""+Выборка.ПравилаСтрахования,
			Выборка.СтраховаяСумма,
			Выборка.СтраховаяПремия,
			""+Выборка.Валюта,
			Выборка.Задолженность,
			""+Выборка.ОбъектСтрахования,
			""+Выборка.МестоДействия,
			""+Выборка.Примечание,
			Выборка.РазрешеноЗаявлениеОнлайн, 
			Выборка.ОписаниеПравилаОформления);
			МассивПолисовДляВозврата.Добавить(Данные);
			
	КонецЦикла;

	Если НомерСтроки = 0 Тогда
		Текст = "Полисы не найдены.";
	КонецЕсли;

	Возврат КонструкторРезультатаMCP(
		ТекстИнструментаMCP(Текст, Ложь, Новый Структура("orders", МассивПолисовДляВозврата)), Идентификатор);

