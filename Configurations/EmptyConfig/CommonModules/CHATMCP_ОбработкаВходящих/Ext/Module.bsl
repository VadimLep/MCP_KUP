// ============================================================================
// HTTP-сервис MCP (Model Context Protocol) для работы с заказами
// (документ ПредзаявкаЗаказчика).
//
// Адрес:  http://<сервер>/<база>/http/MCP/mcp
// Метод:  POST (JSON-RPC 2.0)
//
// Поддерживаемые методы протокола MCP:
//   * initialize                - рукопожатие и согласование версии
//   * notifications/initialized - уведомление о готовности клиента
//   * ping                      - проверка живости
//   * tools/list                - список доступных инструментов
//   * tools/call                - вызов инструмента
//
// Инструменты:
//   * create_order - создание предзаявки заказчика
//   * get_order    - получение данных предзаявки по UUID
//   * list_orders  - поиск списка предзаявок
// ============================================================================

#Область СлужебныеФункции

Функция КонструкторОшибкиMCP(Знач КодОшибки, Знач СообщениеОбОшибках, Знач Идентификатор = Неопределено)
	Ответ = Новый Структура;
	Ответ.Вставить("jsonrpc", "2.0");
	Если Идентификатор <> Неопределено Тогда
		Ответ.Вставить("id", Идентификатор);
	Иначе
		Ответ.Вставить("id", Null);
	КонецЕсли;
	Ошибка = Новый Структура;
	Ошибка.Вставить("code", КодОшибки);
	Ошибка.Вставить("message", СообщениеОбОшибках);
	Ответ.Вставить("error", Ошибка);
	Возврат Ответ;
КонецФункции

Функция КонструкторРезультатаMCP(Знач Результат, Знач Идентификатор)
	Ответ = Новый Структура;
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", Идентификатор);
	Ответ.Вставить("result", Результат);
	Возврат Ответ;
КонецФункции

Функция ВерсияПротоколаMCP()
	Возврат "2024-11-05";
КонецФункции

Функция ЗаписатьJSONВСтроку(Знач ЗначениеJSON)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ЗначениеJSON);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

#КонецОбласти

#Область ОбработчикиЗапросов

// Обработчик POST /mcp - основная точка входа протокола MCP.
// Принимает JSON-RPC 2.0 сообщения (одиночные или пакетные).
Функция НайтиСообщениеMCP(Запрос) Экспорт

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Тело = Запрос.ПолучитьТелоКакСтроку();
	Если ПустаяСтрока(Тело) Тогда
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки(ЗаписатьJSONВСтроку(КонструкторОшибкиMCP(-32700, "Пустое тело запроса")));
		Возврат Ответ;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Тело);
		Сообщение = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки(ЗаписатьJSONВСтроку(
			КонструкторОшибкиMCP(-32700, "Некорректный JSON: " + ОписаниеОшибки())));
		Возврат Ответ;
	КонецПопытки;

	Если ТипЗнч(Сообщение) = Тип("Массив") Тогда
		// Пакетная обработка JSON-RPC сообщений.
		Результаты = Новый Массив;
		Для Каждого Элемент Из Сообщение Цикл
			Обработанное = ОбработатьСообщениеMCP(Элемент);
			Если Обработанное <> Неопределено Тогда
				Результаты.Добавить(Обработанное);
			КонецЕсли;
		КонецЦикла;
		Если Результаты.Количество() = 0 Тогда
			// Только уведомления - отвечаем 202 без тела.
			Ответ.КодСостояния = 202;
			Возврат Ответ;
		КонецЕсли;
		Ответ.УстановитьТелоИзСтроки(ЗаписатьJSONВСтроку(Результаты));
		Возврат Ответ;
	КонецЕсли;

	Обработанное = ОбработатьСообщениеMCP(Сообщение);
	Если Обработанное = Неопределено Тогда
		// Уведомление клиента, ответ не требуется.
		Ответ.КодСостояния =202;
		Возврат Ответ;
	КонецЕсли;

	Ответ.УстановитьТелоИзСтроки(ЗаписатьJSONВСтроку(Обработанное));
	Возврат Ответ;

КонецФункции

Функция ОбработатьСообщениеMCP(Сообщение)

	Если ТипЗнч(Сообщение) <> Тип("Структура") Или Не Сообщение.Свойство("method") Тогда
		Возврат КонструкторОшибкиMCP(-32600, "Некорректный запрос JSON-RPC");
	КонецЕсли;

	Идентификатор = Неопределено;
	Если Сообщение.Свойство("id") Тогда
		Идентификатор = Сообщение.id;
	КонецЕсли;
	ЭтоУведомление = (Идентификатор = Неопределено);

	Метод = Сообщение.method;

	Попытка
		Если Метод = "initialize" Тогда
			Возврат КонструкторРезультатаMCP(ОписаниеСервераMCP(), Идентификатор);
		ИначеЕсли Метод = "notifications/initialized" Или Метод = "initialized" Тогда
			// Уведомление о завершении рукопожатия, ответа нет.
			Возврат КонструкторРезультатаMCP(Новый Структура(), Идентификатор);
		ИначеЕсли Метод = "ping" Тогда
			Возврат КонструкторРезультатаMCP(Новый Структура(), Идентификатор);
		ИначеЕсли Метод = "tools/list" Тогда
			Возврат КонструкторРезультатаMCP(Новый Структура("tools", СписокИнструментовMCP()), Идентификатор);
		ИначеЕсли Метод = "tools/call" Тогда
			Возврат ВызовИнструментаMCP(Сообщение, Идентификатор);
		Иначе
			Если ЭтоУведомление Тогда
				Возврат Неопределено;
			КонецЕсли;
			Возврат КонструкторОшибкиMCP(-32601, "Метод не поддерживается: " + Метод, Идентификатор);
		КонецЕсли;
	Исключение
		Если ЭтоУведомление Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат КонструкторОшибкиMCP(-32603, "Внутренняя ошибка сервера: " + ОписаниеОшибки(), Идентификатор);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область ОписаниеСервераИИнструментов

Функция ОписаниеСервераMCP()

	Описание = Новый Структура;
	Описание.Вставить("protocolVersion", ВерсияПротоколаMCP());
	Возможности = Новый Структура;
	Возможности.Вставить("tools", Новый Структура("listChanged", Ложь));
	Описание.Вставить("capabilities", Возможности);
	Описание.Вставить("serverInfo",
		Новый Структура("name, version, description",
			"insurance-support-chat-mcp-server",
			"1.0.0",
			"MCP-сервис для чата поддержки клиентов (страхователей-физических лиц) страховой компании"));
	Возврат Описание;

КонецФункции

