Функция ЗначениеАргумента(Аргументы, Имя)

	Значение = Неопределено;
	Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
		Если Аргументы.Свойство(Имя, Значение) Тогда
			Если Значение = Неопределено Тогда
				Возврат "";
			КонецЕсли;
			Если ТипЗнч(Значение) = Тип("Булево") Тогда
				Возврат ?(Значение, "true", "false");
			КонецЕсли;
			Возврат Строка(Значение);
		КонецЕсли;
	КонецЕсли;
	Возврат "";

КонецФункции

Функция БулевоИзАргумента(Аргументы, Имя)

	Значение = Неопределено;
	Если Не Аргументы.Свойство(Имя, Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	СтрокаЗначения = НРег(СокрЛП(Строка(Значение)));
	Возврат СтрокаЗначения = "true" Или СтрокаЗначения = "1" Или СтрокаЗначения = "да";

КонецФункции

Функция ЧислоИзАргумента(Аргументы, Имя)

	СтрокаЗначения = ЗначениеАргумента(Аргументы, Имя);
	Если ПустаяСтрока(СтрокаЗначения) Тогда
		Возврат 0;
	КонецЕсли;
	СтрокаЗначения = СтрЗаменить(СтрокаЗначения, " ", "");
	СтрокаЗначения = СтрЗаменить(СтрокаЗначения, ",", ".");
	Попытка
		Возврат Число(СтрокаЗначения);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

Функция РазобратьДату(Знач СтрокаДаты)

	Если ПустаяСтрока(СтрокаДаты) Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Поддерживается формат ГГГГ-ММ-ДД (и ГГГГ-ММ-ДДЧЧ:ММ:СС - берется дата).
	Попытка
		Год = Число(Лев(СтрокаДаты, 4));
		Месяц = Число(Сред(СтрокаДаты, 6, 2));
		День = Число(Сред(СтрокаДаты, 9, 2));
		Если Год < 1900 Или Месяц < 1 Или Месяц > 12 Или День < 1 Или День > 31 Тогда
			Возврат Неопределено;
		КонецЕсли;
		ЗначениеДаты = Дата(Год, Месяц, День);
		// Для значений без времени возвращается КонецДня: дата истечения предложения,
		// указанная как "ГГГГ-ММ-ДД", должна действовать до 23:59:59 этого дня,
		// а не "сгорать" в 00:00.
		Если СтрНайти(СтрокаДаты, ":") = 0 Тогда
			ЗначениеДаты = КонецДня(ЗначениеДаты);
		КонецЕсли;
		Возврат ЗначениеДаты;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция НайтиКонтрагента(Знач СтрокаПоиска)

	// Поиск по коду...
	Ссылка = Справочники.Контрагенты.НайтиПоКоду(СтрокаПоиска);
	Если Ссылка <> Неопределено И Не Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;

	// ...или по полному наименованию...
	Ссылка = Справочники.Контрагенты.НайтиПоНаименованию(СтрокаПоиска, Истина);
	Если Ссылка <> Неопределено И Не Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;

	// ...или по неполному совпадению наименования.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	НЕ Контрагенты.ЭтоГруппа
	|	И НЕ Контрагенты.ПометкаУдаления
	|	И ВЕРХ(Контрагенты.Наименование) ПОДОБНО &Поиск";
	Запрос.УстановитьПараметр("Поиск", "%" + ВРег(СтрокаПоиска) + "%");
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Возврат Результат.Выгрузить()[0].Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция НайтиВалюту(Знач СтрокаПоиска)

	Ссылка = Справочники.Валюты.НайтиПоКоду(СтрокаПоиска);
	Если Ссылка <> Неопределено И Не Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;

	Ссылка = Справочники.Валюты.НайтиПоНаименованию(СтрокаПоиска, Истина);
	Если Ссылка <> Неопределено И Не Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьСтруктуруПолиса(НомерПолиса, ИдентификаторСтрахователя) 
	
	СтраховательСсылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторСтрахователя));

	//_ссылка =  InsuranceOnline.ПолучитьСсылкуПоГУИД(ИдентификаторОбъекта, СтраховательСсылка);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЖурналДоговоров.Ссылка КАК Ссылка,
	|	ЖурналДоговоров.Дата КАК Дата,
	|	ЖурналДоговоров.Номер КАК Номер,
	|	ЖурналДоговоров.Страхователь КАК Страхователь,
	|	ЖурналДоговоров.СтраховаяСумма КАК СтраховаяСумма,
	|	ЖурналДоговоров.СтраховаяПремия КАК СтраховаяПремия,
	|	ВидыСтрахования.Ссылка КАК ВидДоговора,
	|	ЖурналДоговоров.Валюта КАК Валюта
	|ИЗ
	|	ЖурналДокументов.ЖурналДоговоров КАК ЖурналДоговоров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыСтрахования КАК ВидыСтрахования
	|		ПО ЖурналДоговоров.ВидДоговора = ВидыСтрахования.ВидДоговора
	|ГДЕ
	|	ЖурналДоговоров.Проведен
	|	И НЕ ЖурналДоговоров.БланкИспорчен
	|	И ЖурналДоговоров.Номер = &Номер
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЖурналДоговоров.Дата УБЫВ";
	Запрос.УстановитьПараметр("Номер", НомерПолиса);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда
		Возврат Выборка;
	Иначе     
		Возврат Неопределено;
	КонецЕсли;	
КонецФункции

