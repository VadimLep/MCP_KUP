// ============================================================================
// Общий серверный модуль CHATMCP_LLM
//
// Взаимодействие с LLM-моделью через API в стиле OpenAI (chat/completions)
// для чата помощи клиентам страховой компании.
//
// Модуль:
//   * отправляет историю сообщений чата в LLM вместе с описанием инструментов
//     MCP-сервера (получается запросом tools/list на https://portal.kupala.by:4443/KPL6/hs/CHATMCP);
//   * обрабатывает ответы LLM, в том числе вызовы инструментов (tool_calls):
//     каждый вызов транслируется в JSON-RPC запрос tools/call MCP-сервера,
//     результат возвращается LLM в сообщении роли "tool";
//   * выполняет цикл "LLM -> инструменты -> LLM" до получения финального
//     текстового ответа (или пока не будет запрошено переключение на оператора).
//
// Основные экспортные функции:
//   * СпроситьLLM(ТекстСообщения, ИсторияСообщений) - полный диалоговый ход
//     с автоматическим исполнением вызовов инструментов; возвращает Структуру
//     (Ответ, История, БылаОшибка).
//   * ОтправитьВLLM(ЗапросLLM) - низкоуровневый POST chat/completions.
// ============================================================================

#Область ПараметрыИнтеграции

// Настройки подключения к LLM API в стиле OpenAI.
// URL/APIKey/Модель можно переопределить извне (например, константой конфигурации).
Функция НастройкиLLM() Экспорт
	
	Настройки = Новый Структура;
	Настройки.Вставить("URL", "https://api.openai.com/v1/chat/completions");
	Настройки.Вставить("APIKey", "");
	Настройки.Вставить("Модель", "gpt-4o-mini");
	Настройки.Вставить("Температура", 0.2);
	Настройки.Вставить("ТаймаутСекунд", 120);
	// Максимальное число циклов "вызов инструментов -> повторный запрос LLM".
	Настройки.Вставить("МаксимумЦикловИнструментов", 8);
	
	Возврат Настройки;
	
КонецФункции

// Системный промпт ассистента чата помощи страховой компании.
// Формируется динамически: зависит от списка и описания инструментов MCP,
// полученных из функции СписокИнструментовMCP() модуля CHATMCP_ФункцииСервера.
// Список кэшируется на время сеанса, чтобы не перестраивать промпт на каждое сообщение.
Функция СистемныйПромпт() Экспорт


	Инструменты = Новый Массив;
	Попытка
		Инструменты = CHATMCP_ФункцииСервера.СписокИнструментовMCP();
	Исключение
		// Если список получить не удалось - формируем промпт без инструментов.
		Инструменты = Новый Массив;
	КонецПопытки;

	Если ТипЗнч(Инструменты) <> Тип("Массив") Тогда
		Инструменты = Новый Массив;
	КонецЕсли;

	ИнстрКэш = Инструменты;
	ПромптКэш = СформироватьСистемныйПромптИзИнструментов(Инструменты);

	Возврат ПромптКэш;

КонецФункции

// Список инструментов MCP, кэшированный СистемныйПромпт().
// Используется для передачи в LLM без повторного обращения к CHATMCP_ФункцииСервера.
Функция ИнструментыMCPИзКэша() Экспорт

	Перем ИнстрКэш;

	Если ИнстрКэш = Неопределено Тогда
		// Инициализация кэша через формирование промпта.
		СистемныйПромпт();
	КонецЕсли;

	Если ИнстрКэш = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат ИнстрКэш;

КонецФункции

// Формирует текст системного промпта на основе списка инструментов MCP.
//
// Параметры:
// 	Инструменты - Массив - элементы в формате Структура:
// 		name - имя инструмента;
// 		description - описание инструмента;
// 		inputSchema - схема входных параметров {type, properties, required}.
//
// Возвращаемое значение:
// 	Строка - готовый системный промпт для LLM.
//
Функция СформироватьСистемныйПромптИзИнструментов(Инструменты)

	Пс = Символы.ПС;

	Текст =
		"Ты - виртуальный ассистент чата помощи клиентам страховой компании." + Пс +
		"Отвечай вежливо, кратко и по делу, на языке клиента." + Пс + Пс;

	Если Инструменты = Неопределено Или Инструменты.Количество() = 0 Тогда

		Текст = Текст +
			"Сейчас инструменты недоступны. Отвечай общими рекомендациями" + Пс +
			"и при необходимости предлагай клиенту обратиться к оператору.";
		Возврат Текст;

	КонецЕсли;

	Текст = Текст + "Для работы с данными клиента используй доступные инструменты (tools):" + Пс;

	Для Каждого Инстр Из Инструменты Цикл

		Имя = "";
		Описание = "";
		Схема = Неопределено;

		Если ТипЗнч(Инстр) = Тип("Структура") Тогда
			Если НЕ Инстр.Свойство("name") Тогда
				Продожить;
			КонецЕсли;
			Имя = Инстр.name;
			Инстр.Свойство("description", Описание);
			Инстр.Свойство("inputSchema", Схема);
		ИначеЕсли ТипЗнч(Инстр) = Тип("Соответствие") Тогда
			Имя = Инстр["name"];
			Описание = Инстр["description"];
			Схема = Инстр["inputSchema"];
		Иначе
			Продожить;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Имя) Тогда
			Продожить;
		КонецЕсли;

		СтрокаИнструмента = "- " + Имя;
		Если ЗначениеЗаполнено(Описание) Тогда
			СтрокаИнструмента = СтрокаИнструмента + " - " + СокрЛП(Описание);
		КонецЕсли;

		// Перечисление параметров из схемы входных данных (properties/required).
		Свойства = Неопределено;
		Обязательные = Неопределено;
		Если ТипЗнч(Схема) = Тип("Структура") Тогда
			Схема.Свойство("properties", Свойства);
			Схема.Свойство("required", Обязательные);
		ИначеЕсли ТипЗнч(Схема) = Тип("Соответствие") Тогда
			Свойства = Схема["properties"];
			Обязательные = Схема["required"];
		КонецЕсли;

		Если ТипЗнч(Свойства) = Тип("Структура") И Свойства.Количество() > 0 Тогда

			СписокПараметров = "";
			Для Каждого Св Из Свойства Цикл

				ТипПараметра = "string";
				ОписаниеПараметра = "";
				Если ТипЗнч(Св.Значение) = Тип("Структура") Тогда
					Св.Значение.Свойство("type", ТипПараметра);
					Св.Значение.Свойство("description", ОписаниеПараметра);
				ИначеЕсли ТипЗнч(Св.Значение) = Тип("Соответствие") Тогда
					Если ЗначениеЗаполнено(Св.Значение["type"]) Тогда
						ТипПараметра = Св.Значение["type"];
					КонецЕсли;
					ОписаниеПараметра = Св.Значение["description"];
				КонецЕсли;

				Обязателен = Ложь;
				Если ТипЗнч(Обязательные) = Тип("Массив") Тогда
					Обязателен = Обязательные.Найти(Св.Имя) <> Неопределено;
				КонецЕсли;

				Параметр = Св.Имя + " (" + ТипПараметра + ?(Обязателен, ", обязательно", "") + ")";
				Если ЗначениеЗаполнено(ОписаниеПараметра) Тогда
					Параметр = Параметр + ": " + СокрЛП(ОписаниеПараметра);
				КонецЕсли;

				Если СписокПараметров = "" Тогда
					СписокПараметров = Параметр;
				Иначе
					СписокПараметров = СписокПараметров + "; " + Параметр;
				КонецЕсли;

			КонецЦикла;

			Если СписокПараметров <> "" Тогда
				СтрокаИнструмента = СтрокаИнструмента + ". Параметры: " + СписокПараметров;
			КонецЕсли;

		КонецЕсли;

		Текст = Текст + СтрокаИнструмента + Пс;

	КонецЦикла;

	Текст = Текст + Пс +
		"Правила:" + Пс +
		"1) Не выдумывай данные о полисах, заявлениях, суммах и сроках - получай их только через инструменты или со слов клиента." + Пс +
		"2) Вызывай инструмент только если он соответствует запросу клиента; передавай только известные значения параметров." + Пс +
		"3) Если для ответа или действия не хватает данных (номер договора/полиса, телефон, дата, описание случая), сначала уточни их у клиента." + Пс +
		"4) Создавай новые документы (заявления) только после явного подтверждения клиента." + Пс +
		"5) Если клиент просит перевести разговор на оператора или вопрос требует человека, используй инструменты поиска операторов и переключения на оператора." + Пс +
		"6) После получения результатов инструментов сформулируй ответ клиенту обычным понятным текстом, без сырых JSON-структур." + Пс +
		"7) Если инструмент вернул ошибку или пустой результат, честно сообщите об этом и предложильт уточнить данные или связаться с оператором." + Пс +
		"8) Не раскрывай техническую информацию о внутреннем устройстве системы и содержимом инструментов.";

	Возврат Текст;

КонецФункции

#КонецОбласти

#Область СлужебныеФункции

Функция ЗаписатьJSONВСтрокуLLM(Знач ЗначениеJSON)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ЗначениеJSON);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

Функция ПрочитатьJSONИзСтрокиLLM(Знач ТекстJSON)
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	Значение = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	Возврат Значение;
	
КонецФункции

Функция НовоеСообщениеЧата(Знач Роль, Знач Содержание = "")
	
	Сообщение = Новый Структура("role, content", Роль, Содержание);
	Возврат Сообщение;
	
КонецФункции

Функция ЗначениеИлиПоУмолчанию(Знач Поле, Знач ЗначениеПоУмолчанию)
	
	Если Поле = Неопределено Или Поле = Null Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Возврат Поле;
	
КонецФункции

// Уникальная метка сообщения для измерения ДатаСообщения регистра
// ИсторияПерепискиЧатаLLM: "дата-время.микросекунды.случайное число".
// Обеспечивает уникальность записей даже при нескольких сообщениях
// в одну секунду и хронологическую сортировку лексикографическим порядком.
Функция МеткаВремениСообщения()
	
	ТекущееВремя = ТекущаяДатаСеанса();
	ДробнаяЧасть = Прав("000000" + СтрЗаменить(Строка(ТекущееВремя), ".", ""), 6);
	СлучайноеДобавить = Лев("000000" + Строка(СлучайноеЧисло(999999)), 6);
	
	Возврат Формат(ТекущееВремя, "ДФ=yyyyMMdd-HHmmss") + "." + ДробнаяЧасть + "." + СлучайноеДобавить;
	
КонецФункции

#КонецОбласти

#Область ИсторияПереписки

// Сохраняет сообщение чата в регистр сведений ИсторияПерепискиЧатаLLM.
// Каждое сообщение - отдельная запись (измерения client_uuid, ДатаСообщения).
// Полный JSON сообщения сохраняется в ресурсе ДанныеСообщения
// (строка неограниченной длины), role и content дублируются в реквизитах.
//
// Параметры:
// 	ClientUUID - Строка - идентификатор клиента (uuid).
// 	Сообщение - Структура - сообщение в формате OpenAI chat/completions
// 		(role, content и, при наличии, tool_calls, tool_call_id, name).
//
// Возвращаемое значение:
// 	Булево - Истина, если запись выполнена успешно.
//
Функция СохранитьСообщениеИстории(ClientUUID, Сообщение) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ClientUUID) Или ТипЗнч(Сообщение) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РольСообщения = "";
	Сообщение.Свойство("role", РольСообщения);
	РольСообщения = ЗначениеИлиПоУмолчанию(РольСообщения, "");
	
	СодержаниеСообщения = "";
	Сообщение.Свойство("content", СодержаниеСообщения);
	Если СодержаниеСообщения = Null Тогда
		СодержаниеСообщения = "";
	ИначеЕсли ТипЗнч(СодержаниеСообщения) <> Тип("Строка") Тогда
		// Нестроковое содержимое сериализуем в JSON.
		СодержаниеСообщения = ЗаписатьJSONВСтрокуLLM(СодержаниеСообщения);
	КонецЕсли;
	
	Попытка
		ТекстJSON = ЗаписатьJSONВСтрокуLLM(Сообщение);
	Исключение
		ТекстJSON = "{}";
	КонецПопытки;
	
	МенеджерЗаписи = РегистрыСведений.ИсторияПерепискиЧатаLLM.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.client_uuid = ClientUUID;
	МенеджерЗаписи.ДатаСообщения = МеткаВремениСообщения();
	МенеджерЗаписи.Период = ТекущаяДатаСеанса();
	МенеджерЗаписи.ДанныеСообщения = ТекстJSON;
	МенеджерЗаписи.role = Лев(РольСообщения, 20);
	МенеджерЗаписи.content = СодержаниеСообщения;
	МенеджерЗаписи.Записать(Ложь);
	
	Возврат Истина;
	
КонецФункции

// Читает историю переписки клиента из регистра ИсторияПерепискиЧатаLLM.
// Используется для восстановления контекста диалога между сообщениями.
//
// Параметры:
// 	ClientUUID - Строка - идентификатор клиента (uuid).
//
// Возвращаемое значение:
// 	Массив - сообщения (Структура) в формате OpenAI, отсортированные по времени.
//
Функция ПрочитатьИсториюПереписки(ClientUUID) Экспорт
	
	Сообщения = Новый Массив;
	Если НЕ ЗначениеЗаполнено(ClientUUID) Тогда
		Возврат Сообщения;
	КонецЕсли;
	
	МенеджерВыбора = РегистрыСведений.ИсторияПерепискиЧатаLLM.СоздатьМенеджерВыбора();
	
	Отбор = МенеджерВыбора.СоздатьОтбор();
	УсловиеОтбора = Отбор.Новое();
	УсловиеОтбора.Помещение = ПомещениеУсловияОтбора.Лево;
	УсловиеОтбора.Имя = "client_uuid";
	УсловиеОтбора.Вид = ВидУсловияОтбора.Равно;
	УсловиеОтбора.Значение = ClientUUID;
	Отбор.Добавить(УсловиеОтбора);
	МенеджерВыбора.Отбор = Отбор;
	
	Порядок = МенеджерВыбора.СоздатьПорядок();
	УсловиеПорядка = Порядок.Новое();
	УсловиеПорядка.Имя = "ДатаСообщения";
	УсловиеПорядка.Вид = ВидУсловияПорядка.Возрастание;
	Порядок.Добавить(УсловиеПорядка);
	МенеджерВыбора.Порядок = Порядок;
	
	Выборка = МенеджерВыбора.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.ДанныеСообщения) Тогда
			Продожить;
		КонецЕсли;
		Попытка
			Сообщение = ПрочитатьJSONИзСтрокиLLM(Выборка.ДанныеСообщения);
			Если ТипЗнч(Сообщение) = Тип("Структура") Тогда
				Сообщения.Добавить(Сообщение);
			КонецЕсли;
		Исключение
			// Повреждённую запись пропускаем.
		КонецПопытки;
	КонецЦикла;
	
	Возврат Сообщения;
	
КонецФункции

// Удаляет историю переписки клиента из регистра ИсторияПерепискиЧатаLLM.
// Применяется при завершении/сбросе диалога с клиентом.
//
// Параметры:
// 	ClientUUID - Строка - идентификатор клиента (uuid).
//
// Возвращаемое значение:
// 	Булево - Истина, если удаление выполнено (даже если записей не было).
//
Функция УдалитьИсториюПереписки(ClientUUID) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ClientUUID) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Регистратор = РегистрыСведений.ИсторияПерепискиЧатаLLM;
	
	Отбор = Регистратор.СоздатьМенеджерВыбора().СоздатьОтбор();
	УсловиеОтбора = Отбор.Новое();
	УсловиеОтбора.Помещение = ПомещениеУсловияОтбора.Лево;
	УсловиеОтбора.Имя = "client_uuid";
	УсловиеОтбора.Вид = ВидУсловияОтбора.Равно;
	УсловиеОтбора.Значение = ClientUUID;
	Отбор.Добавить(УсловиеОтбора);
	
	МенеджерЗаписи = Регистратор.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Отбор = Отбор;
	МенеджерЗаписи.Удалить();
	
	Возврат Истина;
	
КонецФункции

// Формирует из регистра истории переписки данные запроса для дальнейшей
// передачи в LLM (payload эндпоинта OpenAI-совместимого chat/completions).
//
// Читает сообщения клиента из регистра ИсторияПерепискиЧатаLLM
// (см. ПрочитатьИсториюПереписки), ставит первым системный промпт,
// добавляет новое сообщение клиента (сохраняя его в регистр) и
// подставляет инструменты MCP и параметры генерации из НастройкиLLM().
// Готовый результат можно передать в ОтправитьВLLM() без доработки.
//
// Параметры:
// 	ClientUUID - Строка - идентификатор клиента (uuid) в регистре истории.
// 	ТекстСообщения - Строка - новое сообщение клиента (необязательно);
// 		если пусто - запрос формируется только по сохранённой истории.
//
// Возвращаемое значение:
// 	Структура - данные запроса для LLM:
// 		messages - Массив структур сообщений {role, content, ...}
// 			(системный промпт + история + новое сообщение);
// 		tools - Массив инструментов MCP (отсутствует, если недоступны);
// 		model, temperature - параметры генерации из настроек;
// 		URL, APIKey - адрес и ключ LLM API из настроек.
//
Функция СформироватьДанныеЗапросаДляLLM(ClientUUID, ТекстСообщения = "") Экспорт

	Настройки = НастройкиLLM();

	Сообщения = Новый Массив;

	// Системный промпт всегда первым.
	Сообщения.Добавить(НовоеСообщениеЧата("system", СистемныйПромпт()));

	// История переписки клиента из регистра сведений ИсторияПерепискиЧатаLLM.
	ЗаписаннаяИстория = ПрочитатьИсториюПереписки(ClientUUID);
	Для Каждого Сообщение Из ЗаписаннаяИстория Цикл
		РольСообщения = "";
		Сообщение.Свойство("role", РольСообщения);
		// Системные сообщения в истории пропускаем - промпт уже добавлен выше.
		Если РольСообщения = "system" Тогда
			Продожить;
		КонецЕсли;
		Сообщения.Добавить(Сообщение);
	КонецЦикла;

	// Новое сообщение клиента (если передано) - добавляем и сохраняем в историю.
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		СообщениеКлиента = НовоеСообщениеЧата("user", ТекстСообщения);
		Сообщения.Добавить(СообщениеКлиента);
		СохранитьСообщениеИстории(ClientUUID, СообщениеКлиента);
	КонецЕсли;

	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("messages", Сообщения);
	ДанныеЗапроса.Вставить("model", Настройки.Модель);
	ДанныеЗапроса.Вставить("temperature", Настройки.Температура);
	ДанныеЗапроса.Вставить("URL", Настройки.URL);
	ДанныеЗапроса.Вставить("APIKey", Настройки.APIKey);

	// Инструменты MCP для tool-calls; ошибки получения не должны
	// прерывать формирование запроса - тогда LLM отвечает без инструментов.
	Инструменты = Новый Массив;
	Попытка
		Инструменты = ПолучитьИнструментыMCP();
	Исключение
		Инструменты = Новый Массив;
	КонецПопытки;
	Если ТипЗнч(Инструменты) = Тип("Массив") И Инструменты.Количество() > 0 Тогда
		ДанныеЗапроса.Вставить("tools", Инструменты);
		ДанныеЗапроса.Вставить("tool_choice", "auto");
	КонецЕсли;

	Возврат ДанныеЗапроса;

КонецФункции

#КонецОбласти

#Область ПодключениеKMCP_Серверу

// Запрос к MCP-серверу (JSON-RPC 2.0 поверх HTTP POST).
// Методы MCP: initialize, tools/list, tools/call и т.п.
// Возвращает разобранный JSON-RPC ответ; error превращается в исключение.
Функция ЗапросKMCP(Знач Метод, Знач Параметры = Неопределено, Знач Идентификатор = 1) Экспорт
	
	Сообщение = Новый Структура;
	Сообщение.Вставить("jsonrpc", "2.0");
	Сообщение.Вставить("id", Идентификатор);
	Сообщение.Вставить("method", Метод);
	Если Параметры <> Неопределено Тогда
		Сообщение.Вставить("params", Параметры);
	КонецЕсли;
	
	//// НеиспользуемоеЗащищенноеСоединение() - отключение проверки сертификата сервера.
	//ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	//
	//HTTPСоединение = Новый HTTPСоединение(
	//	"portal.kupala.by", 4443, , , , 60, ЗащищенноеСоединение);
	//
	//HTTPЗапрос = Новый HTTPЗапрос("/KPL6/hs/CHATMCP");
	//HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	//HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");
	//HTTPЗапрос.УстановитьТелоИзСтроки(
	//	ЗаписатьJSONВСтрокуLLM(Сообщение), КодировкаТекста.UTF8);
	//
	//HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
	//
	//Тело = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	//Если HTTPОтвет.КодСостояния >= 400 Тогда
	//	ВызватьИсключение "MCP-сервер вернул код " + HTTPОтвет.КодСостояния + ": " + Лев(Тело, 500);
	//КонецЕсли;
	//Если ПустаяСтрока(Тело) Тогда
	//	Возврат Неопределено;
	//КонецЕсли;          
	
	Разобранный = CHATMCP_ФункцииСервера.ОбработатьСообщениеMCP(Сообщение);
	
	//Разобранный = ПрочитатьJSONИзСтрокиLLM(Тело);
	
	Если ТипЗнч(Разобранный) = Тип("Структура") Тогда
		Ошибка = Неопределено;
		Если Разобранный.Свойство("error", Ошибка) И Ошибка <> Null Тогда
			ТекстОшибки = "Ошибка MCP-сервера";
			Если ТипЗнч(Ошибка) = Тип("Структура") Тогда
				СообщениеОбОшибке = Неопределено;
				Если Ошибка.Свойство("message", СообщениеОбОшибке) И СообщениеОбОшибке <> Null Тогда
					ТекстОшибки = ТекстОшибки + ": " + СообщениеОбОшибке;
				КонецЕсли;
			КонецЕсли;
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Разобранный;
	
КонецФункции

// Получение списка инструментов из MCP-сервера (метод tools/list).
// Возвращает массив описаний инструментов в формате OpenAI tools:
// {"type":"function","function":{name, description, parameters}}.
Функция ПолучитьИнструментыMCP() Экспорт
	
	Инструменты = Новый Массив;
	
	Попытка
		Ответ = ЗапросKMCP("tools/list", Новый Структура, 2);
	Исключение
		// Если список получить не удалось - работаем без инструментов.
		Возврат Инструменты;
	КонецПопытки;
	
	Результат = Неопределено;
	Если Ответ <> Неопределено И Ответ.Свойство("result", Результат) И Результат <> Неопределено Тогда
		
		Список = Неопределено;
		Если Результат.Свойство("tools", Список) И ТипЗнч(Список) = Тип("Массив") Тогда
			
			Для Каждого Инструмент Из Список Цикл
				
				ПараметрыСхемы = ЗначениеИлиПоУмолчанию(Инструмент.inputSchema,
					Новый Структура("type, properties", "object", Новый Структура));
				
				ОписаниеФункции = Новый Структура;
				ОписаниеФункции.Вставить("name", ЗначениеИлиПоУмолчанию(Инструмент.name, ""));
				ОписаниеФункции.Вставить("description", ЗначениеИлиПоУмолчанию(Инструмент.description, ""));
				ОписаниеФункции.Вставить("parameters", ПараметрыСхемы);
				
				Описание = Новый Структура("type, function", "function", ОписаниеФункции);
				Инструменты.Добавить(Описание);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Инструменты;
	
КонецФункции

// Исполнение одного вызова инструмента: tools/call на MCP-сервере.
// Возвращает текстовое содержимое результата (для сообщения роли "tool").
// Вызов инструмента MCP (tools/call). ClientUUID - для сохранения вызова в историю переписки.
Функция ВыполнитьВызовИнструментаMCP(Знач ИмяИнструмента, Знач Аргументы, Знач ИдентификаторВызова, Знач ClientUUID = Неопределено) Экспорт
	
	Если ТипЗнч(Аргументы) <> Тип("Структура") Тогда
		Аргументы = Новый Структура;
	КонецЕсли;
	
	Параметры = Новый Структура("name, arguments", ИмяИнструмента, Аргументы);
	Ответ = ЗапросKMCP("tools/call", Параметры, ИдентификаторВызова);

	// Сохраняем сам вызов инструмента (аргументы) в историю переписки клиента.
	Если ЗначениеЗаполнено(ClientUUID) Тогда
		СообщениеВызова = НовоеСообщениеЧата("tool", "");
		СообщениеВызова.Вставить("name", ИмяИнструмента);
		СообщениеВызова.Вставить("tool_call_id", "call_" + МеткаВремениСообщения());
		СообщениеВызова.Вставить("arguments", Аргументы);
		СохранитьСообщениеИстории(ClientUUID, СообщениеВызова);
	КонецЕсли;
	
	ТекстРезультата = "";
	Результат = Неопределено;
	Если Ответ <> Неопределено И Ответ.Свойство("result", Результат) И Результат <> Неопределено Тогда
		
		Содержимое = Неопределено;
		Если Результат.Свойство("content", Содержимое) И ТипЗнч(Содержимое) = Тип("Массив") Тогда
			Части = Новый Массив;
			Для Каждого Блок Из Содержимое Цикл
				ТекстБлока = Неопределено;
				Если Блок.Свойство("text", ТекстБлока) И ТекстБлока <> Null Тогда
					Части.Добавить(ТекстБлока);
				КонецЕсли;
			КонецЦикла;
			ТекстРезультата = СтрСоединить(Части, Символы.ПС);
		КонецЕсли;
		
		// Структурированные данные добавляем к тексту, если текста нет.
		Данные = Неопределено;
		Если Результат.Свойство("structuredContent", Данные) И Данные <> Неопределено Тогда
			Если ПустаяСтрока(ТекстРезультата) Тогда
				ТекстРезультата = ЗаписатьJSONВСтрокуLLM(Данные);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПустаяСтрока(ТекстРезультата) Тогда
		ТекстРезультата = "Инструмент """ + ИмяИнструмента + """ не вернул данных.";
	КонецЕсли;
	
	Возврат ТекстРезультата;
	
КонецФункции

#КонецОбласти

#Область РаботаCLLM

// Низкоуровневый POST chat/completions в API в стиле OpenAI.
// ЗапросLLM: Структура с полями model, messages, temperature, tools (необязательно),
//            tool_choice (необязательно), URL/APIKey (необязательные переопределения).
// Возвращает первую choice ответа; при ошибке - Исключение.
Функция ОтправитьВLLM(ЗапросLLM) Экспорт
	
	Настройки = НастройкиLLM();
	
	Тело = Новый Структура;
	Тело.Вставить("model", ЗначениеИлиПоУмолчанию(ЗапросLLM.model, Настройки.Модель));
	Тело.Вставить("messages", ЗапросLLM.messages);
	Тело.Вставить("temperature", ЗначениеИлиПоУмолчанию(ЗапросLLM.temperature, Настройки.Температура));
	Если ЗапросLLM.Свойство("tools") И ТипЗнч(ЗапросLLM.tools) = Тип("Массив") И ЗапросLLM.tools.Количество() > 0 Тогда
		Тело.Вставить("tools", ЗапросLLM.tools);
		Тело.Вставить("tool_choice", ЗначениеИлиПоУмолчанию(ЗапросLLM.tool_choice, "auto"));
	КонецЕсли;
	
	URL = ЗначениеИлиПоУмолчанию(ЗапросLLM.URL, Настройки.URL);
	РазборURL = КоннекторHTTP.РазобратьURL(URL);
	
	ЗащищенноеСоединение = Неопределено;
	Если РазборURL.Схема = "https" Тогда
		// НеиспользуемоеЗащищенноеСоединение() - отключение проверки сертификата сервера.
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	КонецЕсли;
	
	Соединение = Новый HTTPСоединение(
		РазборURL.Хост, , , , , Настройки.ТаймаутСекунд, ЗащищенноеСоединение);
	
	ПутьЗапроса = РазборURL.Путь;
	Если Не ПустаяСтрока(РазборURL.Параметры) Тогда
		ПутьЗапроса = ПутьЗапроса + "?" + РазборURL.Параметры;
	КонецЕсли;
	
	Запрос = Новый HTTPЗапрос(ПутьЗапроса);
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.Заголовки.Вставить("Accept", "application/json");
	APIKey = ЗначениеИлиПоУмолчанию(ЗапросLLM.APIKey, Настройки.APIKey);
	Если Не ПустаяСтрока(APIKey) Тогда
		Запрос.Заголовки.Вставить("Authorization", "Bearer " + APIKey);
	КонецЕсли;
	Запрос.УстановитьТелоИзСтроки(
		ЗаписатьJSONВСтрокуLLM(Тело), КодировкаТекста.UTF8);
	
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	ТекстОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "LLM API вернул код " + Ответ.КодСостояния + ": " + Лев(ТекстОтвета, 500);
	КонецЕсли;
	
	РазобранныйОтвет = ПрочитатьJSONИзСтрокиLLM(ТекстОтвета);
	
	Выборы = Неопределено;
	Если РазобранныйОтвет.Свойство("choices", Выборы)
		И ТипЗнч(Выборы) = Тип("Массив") И Выборы.Количество() > 0 Тогда
		Возврат Выборы[0];
	КонецЕсли;
	
	ВызватьИсключение "Некорректный ответ LLM API: " + Лев(ТекстОтвета, 500);
	
КонецФункции

// Полный диалоговый ход: отправка сообщения клиента в LLM с инструментами MCP
// и автоматическое исполнение вызовов инструментов до финального ответа.
//
//  Параметры:
//   ТекстСообщения    - новое сообщение клиента;
//   ИсторияСообщений  - Массив структур {role, content, ...} (необязательно),
//                       накапливается и возвращается для сохранения контекста чата.
//
//  Возвращает: Структура(Ответ - текст для клиента, История, БылаОшибка).
Функция СпроситьLLM(ТекстСообщения, ИсторияСообщений = Неопределено, ClientUUID = Неопределено) Экспорт
	
	Если ИсторияСообщений = Неопределено Или ТипЗнч(ИсторияСообщений) <> Тип("Массив") Тогда
		// Если история не передана, но известен клиент - восстанавливаем её из регистра.
		ИсторияСообщений = ПрочитатьИсториюПереписки(ClientUUID);
	КонецЕсли;
	
	Результат = Новый Структура("Ответ, История, БылаОшибка", "", ИсторияСообщений, Ложь);
	
	// При первом сообщении добавляем системный промпт.
	Если ИсторияСообщений.Количество() = 0 Тогда
		ИсторияСообщений.Добавить(НовоеСообщениеЧата("system", СистемныйПромпт()));
	КонецЕсли;
	СообщениеКлиента = НовоеСообщениеЧата("user", ТекстСообщения);
	ИсторияСообщений.Добавить(СообщениеКлиента);
	СохранитьСообщениеИстории(ClientUUID, СообщениеКлиента);
	
	Настройки = НастройкиLLM();
	Инструменты = ПолучитьИнструментыMCP();
	
	ИдентификаторВызова = 100;
	Для СчётчикЦикла = 1 По Настройки.МаксимумЦикловИнструментов Цикл
		
		ЗапросLLM = Новый Структура;
		ЗапросLLM.Вставить("messages", ИсторияСообщений);
		Если Инструменты.Количество() > 0 Тогда
			ЗапросLLM.Вставить("tools", Инструменты);
		КонецЕсли;
		
		Попытка
			Choice = ОтправитьВLLM(ЗапросLLM);
		Исключение
			Результат.БылаОшибка = Истина;
			Результат.Ответ = "К сожалению, сервис помощи временно недоступен. "
				+ "Пожалуйста, попробуйте позже или обратитесь к оператору.";
			Возврат Результат;
		КонецПопытки;
		
		СообщениеАссистента = Неопределено;
		Choice.Свойство("message", СообщениеАссистента);
		Если СообщениеАссистента = Неопределено Тогда
			Результат.БылаОшибка = Истина;
			Результат.Ответ = "LLM вернула пустой ответ. Пожалуйста, повторите вопрос.";
			Возврат Результат;
		КонецЕсли;
		
		// Фиксируем ответ ассистента в истории (включая tool_calls) и в регистре.
		ИсторияСообщений.Добавить(СообщениеАссистента);
		СохранитьСообщениеИстории(ClientUUID, СообщениеАссистента);
		
		ВызовыИнструментов = Неопределено;
		Если СообщениеАссистента.Свойство("tool_calls", ВызовыИнструментов)
			И ТипЗнч(ВызовыИнструментов) = Тип("Массив") И ВызовыИнструментов.Количество() > 0 Тогда
			
			Для Каждого Вызов Из ВызовыИнструментов Цикл
				
				ФункцияВызова = Новый Структура;
				Вызов.Свойство("function", ФункцияВызова);
				ИмяИнструмента = "";
				ФункцияВызова.Свойство("name", ИмяИнструмента);
				
				// Аргументы приходят JSON-строкой.
				Аргументы = Новый Структура;
				ТекстАргументов = "";
				Если ФункцияВызова.Свойство("arguments", ТекстАргументов)
					И ТипЗнч(ТекстАргументов) = Тип("Строка") И Не ПустаяСтрока(ТекстАргументов) Тогда
					Попытка
						РазобранныеАргументы = ПрочитатьJSONИзСтрокиLLM(ТекстАргументов);
						Если ТипЗнч(РазобранныеАргументы) = Тип("Структура") Тогда
							Аргументы = РазобранныеАргументы;
						КонецЕсли;
					Исключение
						Аргументы = Новый Структура;
					КонецПопытки;
				КонецЕсли;
				
				ИдентификаторВызова = ИдентификаторВызова + 1;
				Попытка
					ТекстРезультатаИнструмента = ВыполнитьВызовИнструментаMCP(
					ИмяИнструмента, Аргументы, ИдентификаторВызова, ClientUUID);
				Исключение
					ТекстРезультатаИнструмента = "Ошибка исполнения инструмента """ + ИмяИнструмента
						+ """: " + ОписаниеОшибки();
				КонецПопытки;
				
				СообщениеИнструмента = НовоеСообщениеЧата("tool", ТекстРезультатаИнструмента);
				ИдентификаторВызоваСтроки = "";
				Вызов.Свойство("id", ИдентификаторВызоваСтроки);
				СообщениеИнструмента.Вставить("tool_call_id", ЗначениеИлиПоУмолчанию(ИдентификаторВызоваСтроки, ""));
				СообщениеИнструмента.Вставить("name", ИмяИнструмента);
				ИсторияСообщений.Добавить(СообщениеИнструмента);
			СохранитьСообщениеИстории(ClientUUID, СообщениеИнструмента);
				
			КонецЦикла;
			
			// Продолжаем цикл - отдаём результаты инструментов LLM.
			//Продожить;
		КонецЕсли;
		
		// Финальный текстовый ответ.
		ТекстОтвета = "";
		СообщениеАссистента.Свойство("content", ТекстОтвета);
		Если ТекстОтвета = Null Тогда
			ТекстОтвета = "";
		КонецЕсли;
		Результат.Ответ = ТекстОтвета;
		Возврат Результат;
		
	КонецЦикла;
	
	Результат.БылаОшибка = Истина;
	Результат.Ответ = "Не удалось завершить обработку запроса. Пожалуйста, уточните вопрос или обратитесь к оператору.";
	Возврат Результат;
	
КонецФункции

#КонецОбласти
